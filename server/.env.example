PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# YandexGPT (Yandex Foundation Models) — используется для генерации
# недостающих инструкций. Получить: https://console.yandex.cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest

# Авторизация администратора (управление инструкциями: генерация, удаление).
# JWT_SECRET обязателен и должен содержать не менее 32 случайных байт.
# Пример генерации:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# ADMIN_PASSWORD_HASH получить командой: node scripts/hash-password.js "мойПароль"
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Получатель уведомлений при сохранении данных компании.
# Используется существующее SMTP-подключение (SMTP_HOST/PORT/SECURE/USER/PASS/FROM).
# Если не задан, уведомления отправляются на bd@boykovdocs.ru.
COMPANY_PROFILE_NOTIFICATION_TO=bd@boykovdocs.ru

# Расписание автогенерации новых инструкций из очереди
# server/src/data/professionQueue.json (по одной инструкции за срабатывание).
# Формат — обычное cron-выражение. По умолчанию — раз в час, то есть
# ~24 инструкции в сутки (в диапазоне 20-30, который просили).
DAILY_GENERATION_CRON=0 * * * *
