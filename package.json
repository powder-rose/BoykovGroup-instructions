{
  "name": "boykovgroup-instructions",
  "version": "1.0.0",
  "private": true,
  "description": "-    :    +     YandexGPT",
  "scripts": {
    "install:all": "npm install --prefix server \u0026\u0026 npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npm run dev:server \u0026 npm run dev:client",
    "build:client": "npm run build --prefix client",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"client/vite.config.js\" \"client/package.json\" \"server/src/**/*.js\" \"server/tests/**/*.js\" \"server/scripts/**/*.js\" \"server/package.json\" \"scripts/**/*.mjs\" \".github/**/*.{yml,yaml}\" \"deploy/**/*.{yml,yaml}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"client/vite.config.js\" \"client/package.json\" \"server/src/**/*.js\" \"server/tests/**/*.js\" \"server/scripts/**/*.js\" \"server/package.json\" \"scripts/**/*.mjs\" \".github/**/*.{yml,yaml}\" \"deploy/**/*.{yml,yaml}\" \"*.{json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
